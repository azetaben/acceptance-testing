<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <!--
      Disallow invisible/format characters (and a few common non-breaking spaces)
      that tend to trigger `javac: illegal character: '\uXXXX'`.

      Notes:
      - U+2065 is included via the \u2060-\u206F range.
      - This is a repo guardrail; it does not change runtime behavior.
    -->
    <module name="RegexpMultiline">
        <property name="format"
                  value="[\u00A0\u00AD\u1680\u180E\u2000-\u200F\u202A-\u202E\u202F\u205F\u2060-\u206F\u3000\uFEFF]"/>
        <property name="message"
                  value="Illegal/invisible Unicode character found in source. Remove it (e.g. U+2065)."/>
    </module>
</module>

